{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Console",
  "version": "0.1.0",
  "identifier": "com.openclaw.console",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw Console",
        "width": 1480,
        "height": 920,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
